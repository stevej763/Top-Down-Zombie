# Copy to .env and fill in. `docker compose` reads .env from the repo root; the server itself
# doesn't, so for `./gradlew :app:bootRun` export these in your shell instead.

# ---- Server (docker compose passes these to the server container) ----

# The first admin portal account, created at startup while there are no admins. Ignored after.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Postgres password, used by both the db and server containers. Changing it after the db volume
# exists has no effect on the db (Postgres only reads it on first init).
DB_PASSWORD=topdownsurvival

# Origins allowed to call /api and /ws directly (comma-separated). The default is the web dev
# server plus the mobile app's WebView origins (iOS, Android).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost

# Dev only: delays every /ws message by this many ms in each direction, to try client prediction.
DEBUG_LATENCY_MS=0

# ---- Server outside compose (bootRun) ----
# Compose hard-codes these to its own db container.
# DB_URL=jdbc:postgresql://localhost:5432/topdownsurvival
# DB_USER=topdownsurvival

# ---- Dev tools (read from the shell by npm/Gradle, not from this file) ----
# API_TARGET=http://localhost:8552      # admin/mobile `npm run dev`: where /api and /ws are proxied (default http://localhost:8080)
# VITE_SERVER_URL=https://example.com   # client/mobile build: the server's origin when the page isn't served by it (the mobile apps)
# CAP_DEV_URL=http://192.168.1.10:5175  # mobile `npm run sync`: load the dev server on a device for live reload
# REGENERATE_PARITY=1                   # server tests: rewrite SimParityTest's parity.txt
